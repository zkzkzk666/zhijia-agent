# 智驾辅助 Agent 配置
# 复制本文件为 .env 并填写

# OpenAI 兼容接口地址（可指向任意 OpenAI 兼容服务）
LLM_BASE_URL=https://api.openai.com/v1

# API Key
LLM_API_KEY=sk-your-key

# 默认模型名
LLM_MODEL=gpt-4o-mini

# 服务监听地址（默认仅本机；公网部署可改为 0.0.0.0 并自行加反向代理鉴权）
HOST=127.0.0.1

# 服务端口
PORT=8000

# 允许的跨域来源，逗号分隔；* 表示全部（默认仅本机使用）
CORS_ORIGINS=*

# 单次上传文件大小上限（MB）
MAX_UPLOAD_MB=20

# LLM 请求超时（秒）
LLM_TIMEOUT=300
